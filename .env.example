# Copy this template to .env.local for local development.
# Firebase web config is public client config and still appears in the browser bundle.
# Never put Gemini API keys, service-account JSON, or private server secrets in VITE_* variables.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_VECTOR_EMULATORS=false

# Optional image-analysis utility: export GEMINI_API_KEY in your shell before running it.
# This value is server-side only; do not prefix it with VITE_.
# scripts/serve.mjs accepts PORT; its default is 3000.
