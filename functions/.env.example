# Runtime configuration for Firebase Cloud Functions.
# Values here are local-only; never commit a real .env file.
VECTOR_DATABASE_ID=your-firestore-database-id
VECTOR_STORAGE_BUCKET=your-project.firebasestorage.app
# Configure this secret through Firebase Secret Manager, not a .env file:
# firebase functions:secrets:set VECTOR_MASTER_PASSWORD_HASH
# The value is a scrypt$salt$hash or pbkdf2-sha256$iterations$salt$hash verifier.
