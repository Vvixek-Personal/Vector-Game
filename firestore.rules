rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function developer() {
      return signedIn() && (
        (request.auth.token.email == 'personal.me.vivek@gmail.com' && request.auth.token.email_verified == true)
        || (exists(/databases/$(database)/documents/accounts/$(request.auth.uid))
          && get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.developerUntil > request.time.toMillis())
      );
    }
    match /accounts/{uid} {
      allow get: if owner(uid) || developer();
      allow list: if developer();
      allow write: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || developer();
      allow list: if developer();
      allow create: if owner(uid) && request.resource.data.userId == uid
        && request.resource.data.keys().hasOnly(['userId','settings','settingsUpdatedAt','preferences','preferencesUpdatedAt','updatedAt']);
      allow update: if owner(uid) && request.resource.data.userId == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId','settings','settingsUpdatedAt','preferences','preferencesUpdatedAt','updatedAt']);
      allow delete: if false;
    }
    match /catalog/{id} { allow read: if true; allow write: if false; }
    match /players/{uid} { allow read: if signedIn(); allow write: if false; }
    match /gifts/{id} {
      allow read: if signedIn() && (resource.data.sender == request.auth.uid || resource.data.recipient == request.auth.uid || developer());
      allow write: if false;
    }
    match /feedback/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || developer()); allow write: if false; }
    match /ledger/{id} { allow read: if developer(); allow write: if false; }
    match /leaderboard/{id} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
